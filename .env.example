# Default is mock so the demo runs without secrets.
RUN_MODE=mock
AGENT_TARGET=OOBE Protocol

# AceDataCloud live mode. Prefer x402 for the bounty category.
# live token mode: set ACE_PAYMENT_MODE=token and ACEDATACLOUD_API_TOKEN.
# live x402 mode: set ACE_PAYMENT_MODE=x402 and a funded burner EVM private key.
ACE_PAYMENT_MODE=x402
ACEDATACLOUD_API_TOKEN=
ACE_X402_NETWORK=base
ACE_EVM_PRIVATE_KEY=

# SAP / OOBE. Use a fresh burner Solana keypair path; never paste a seed phrase here.
SYNAPSE_RPC_URL=https://us-1-mainnet.oobeprotocol.ai/rpc?api_key=replace_me
SAP_AGENT_KEYPAIR_PATH=keys/agent.json
SAP_AGENT_PUBLIC_KEY=
SAP_AGENT_ENDPOINT=https://api.acedata.cloud
SAP_AGENT_URI=https://raw.githubusercontent.com/ccmqcy/oobe-ace-agent/master/docs/sap-agent-metadata.json

# Optional metadata for submission.
GITHUB_REPO_URL=
DEMO_VIDEO_URL=
X_POST_URL=
